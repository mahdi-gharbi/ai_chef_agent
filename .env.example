# Optional chosen provider: gemini, qwen, ollama; blank uses existing YAML selection.
KOOKI_PROVIDER=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
SPOONACULAR_API_KEY=
# Local main model; run ollama pull qwen2.5:7b first.
KOOKI_OLLAMA_MODEL=qwen2.5:7b
KOOKI_OLLAMA_BASE_URL=http://localhost:11434
# Existing RAG needs DashScope; never assume it is offline.
KOOKI_ENABLE_RAG=false
# Optional path; blank defaults to data/kooki_api.db (keep persistent and private).
KOOKI_API_DB_PATH=
