      "parameters": {
        "jsCode": "const b = $json.body ?? {};\nconst id = /^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$/;\nconst valid = typeof b.user_id === 'string' && id.test(b.user_id)\n && typeof b.session_id === 'string' && id.test(b.session_id)\n && typeof b.message === 'string' && b.message.trim().length > 0 && b.message.length <= 8000\n && (b.metadata === undefined || (b.metadata !== null && typeof b.metadata === 'object' && !Array.isArray(b.metadata)))\n && JSON.stringify(b.metadata ?? {}).length <= 4096\n && (b.idempotency_key === undefined || (typeof b.idempotency_key === 'string' && id.test(b.idempotency_key)));\nif (!valid) return [{json:{valid:false,http_status:422,result:{status:'error',execution_id:null,error_type:'VALIDATION_ERROR',message:'The request is invalid.',retryable:false}}}];\nreturn [{json:{valid:true,payload:{user_id:b.user_id,session_id:b.session_id,message:b.message.trim(),metadata:{...(b.metadata ?? {}),channel:'n8n'},idempotency_key:b.idempotency_key ?? `n8n-${$execution.id}`}}}];",
